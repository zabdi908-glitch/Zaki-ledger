# Zaki Ledger — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# --- Anthropic (vision extraction) ---------------------------------------
# Used by lib/anthropic.ts for confidence-scored invoice extraction.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (correction ledger + invoices) -----------------------------
# Server-side only. Leave BOTH blank to run in the in-memory skeleton mode
# (the app still works end-to-end, but nothing is persisted).
# Find these in Supabase: Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key bypasses RLS and must stay server-side. Never expose it
# to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
