# Zaki Ledger — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# --- OpenAI (primary extraction) -----------------------------------------
# Uses gpt-4o-mini for the first-pass read on every uploaded document
# (invoice, receipt, or bank statement). Inexpensive — safe to run on
# every upload.
OPENAI_API_KEY=sk-...

# --- Anthropic (escalation tier) -----------------------------------------
# Used for low-confidence extractions that need a stronger vision model.
# Claude Sonnet re-attempts documents where the OpenAI first pass scores
# below the confidence threshold.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase Auth (login/signup) -----------------------------------------
# REQUIRED — unlike everything else below, there is no offline/in-memory mode
# for auth. SUPABASE_URL and SUPABASE_ANON_KEY are both needed just to load
# any page; see lib/supabase-server.ts. In the Supabase dashboard, also enable
# the Email/Password provider and turn OFF "Confirm email" (Authentication →
# Settings) so signup logs a user in immediately.
# Find both in Supabase: Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon key is safe to expose to the browser, but this app only ever uses it
# server-side (cookie-based sessions) — see lib/supabase-server.ts.
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Supabase persistence (correction ledger + invoices) -------------------
# Optional. Leave blank and every logged-in user still shares one in-memory
# queue/ledger that resets on restart — fine for trying the app out, not for
# real use with more than one person. Run db/schema.sql in the SQL editor
# first.
# The service_role key bypasses RLS and must stay server-side. Never expose it
# to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Accounting integrations (Xero / QuickBooks) -------------------------
# Leave blank to keep the app in demo mode: approvals still work, they just
# don't post a bill anywhere. Set a platform's client id + secret to enable
# connecting it (visit /api/xero/connect or /api/quickbooks/connect).
# Register the redirect URIs in each provider's app config:
#   Xero:        {APP_BASE_URL}/api/xero/callback
#   QuickBooks:  {APP_BASE_URL}/api/quickbooks/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QuickBooks hits the sandbox company API by default. Set to "production" to
# post bills to a live company.
QUICKBOOKS_ENVIRONMENT=sandbox
# Explicitly enable the code-pinned, production-hosted QuickBooks Sandbox pilot.
# Its realm, operation pair, OAuth probe, and provider transport are fixed in
# the executor and do not use QUICKBOOKS_ENVIRONMENT.
QUICKBOOKS_SANDBOX_PILOT_ENABLED=false

# Base URL used to build OAuth redirect URIs. On Render this is set
# automatically via RENDER_EXTERNAL_URL — leave APP_URL unset there. Set APP_URL
# only on other hosts, or to pin a value locally. Falls back to
# http://localhost:3000 for local dev.
# APP_URL=https://your-app.onrender.com

# --- Cron jobs -------------------------------------------------------------
# Secret token used to protect the nightly reconciliation cron endpoint.
# Set this to a long random string and configure your cron provider
# (Render Cron, GitHub Actions, etc.) to send it as the x-cron-secret header.
# Without it the /api/cron/nightly-reconciliation endpoint returns 401.
CRON_SECRET=replace-with-a-random-string
